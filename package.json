{
  "name": "@xtnd-dynamics/mcp-gmail",
  "version": "0.2.0",
  "description": "Secure MCP server for Gmail with OAuth2 desktop profiles and an encrypted hosted credential vault.",
  "license": "MIT",
  "author": "XTND Dynamics",
  "homepage": "https://github.com/XTND-DYNAMICS/xtnd-mcp-gmail#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/XTND-DYNAMICS/xtnd-mcp-gmail.git"
  },
  "bugs": {
    "url": "https://github.com/XTND-DYNAMICS/xtnd-mcp-gmail/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "email",
    "gmail",
    "google-workspace",
    "oauth2",
    "ai-agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-gmail": "./dist/cli.js",
    "xtnd-mcp-gmail": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".mcp.json",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "smithery.yaml",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "xsuite-stamp --no-dependencies",
    "predev": "xsuite-stamp --no-dependencies",
    "dev": "wrangler dev",
    "predeploy": "xsuite-stamp --no-dependencies",
    "deploy": "wrangler deploy",
    "precheck": "npm run typegen && xsuite-stamp --no-dependencies",
    "check": "tsc --noEmit",
    "prebuild": "npm run typegen && xsuite-stamp --no-dependencies",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "sync:smithery": "tsx scripts/sync-smithery.ts",
    "pretest": "xsuite-stamp --no-dependencies",
    "test": "tsx --test test/*.test.ts",
    "pretest:security": "xsuite-stamp --no-dependencies",
    "test:security": "tsx --test test/oauth-pkce.test.ts test/local-profile-store.test.ts test/scopes.test.ts test/worker-auth.test.ts",
    "pretest:stdio": "xsuite-stamp --no-dependencies",
    "test:stdio": "tsx scripts/test-local-stdio.ts",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xtnd-dynamics/xtnd-platform": "^0.7.0",
    "worker-mailer": "^1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@xtnd-dynamics/xtnd-core-web": "^0.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=20"
  }
}
